{
	"name": "@earendil-works/tau-ai",
	"version": "0.78.1",
	"description": "OpenRouter-focused LLM API for Tau",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./openai-completions": {
			"types": "./dist/providers/openai-completions.d.ts",
			"import": "./dist/providers/openai-completions.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"generate-models": "tsx scripts/generate-models.ts",
		"build": "bun run clean && bun run generate-models && tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "bun run clean && bun run build"
	},
	"dependencies": {
		"http-proxy-agent": "7.0.2",
		"https-proxy-agent": "7.0.6",
		"openai": "6.26.0",
		"partial-json": "0.1.7",
		"typebox": "1.1.38"
	},
	"keywords": [
		"ai",
		"llm",
		"openrouter",
		"api",
		"tau"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pekka1398/tau.git",
		"directory": "packages/ai"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "24.12.4",
		"canvas": "3.2.3",
		"vitest": "3.2.4"
	}
}
