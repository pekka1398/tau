{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"*": ["./*"],
			"@earendil-works/tau-coding-agent": ["./src/index.ts"],
			"@earendil-works/tau-coding-agent/*": ["./src/*"],
			"typebox": ["./node_modules/typebox"]
		}
	},
	"include": ["src/**/*", "scripts/**/*.ts"],
	"exclude": ["**/dist/**", "test/**", "examples/**"]
}
