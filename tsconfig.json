{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"*": ["./*"],
			"@earendil-works/tau-ai": ["./packages/ai/src/index.ts"],
			"@earendil-works/tau-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@earendil-works/tau-ai/dist/*": ["./packages/ai/src/*"],
			"@earendil-works/tau-agent-core": ["./packages/agent/src/index.ts"],
			"@earendil-works/tau-agent-core/*": ["./packages/agent/src/*"],
			"@earendil-works/tau-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@earendil-works/tau-coding-agent/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@earendil-works/tau-tui": ["./packages/tui/src/index.ts"],
			"@earendil-works/tau-tui/*": ["./packages/tui/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/ai/test/**", "packages/agent/test/**", "packages/coding-agent/test/**", "packages/coding-agent/examples/**", "test/**"]
}
